rules_version = '2';

// Deploy with: firebase deploy --only firestore:rules
// Or paste into Firebase Console: Firestore Database -> Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // Per-user cellar backup. Each user's wines live at cellar/{uid}.
    // Only the authenticated owner can read or write their own document.
    match /cellar/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Blog posts (feature retired). Reads stay public so older app versions
    // still load; nobody can post anymore. Owners may delete their own posts
    // (used by account deletion). No edits.
    match /blog_posts/{postId} {
      allow read: if true;

      allow create: if false;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      allow update: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
